# Supabase – Pflicht. Ohne diese Werte zeigt die Seite die Störungsseite (keine Testdaten).
# Nur serverseitig genutzt – öffentlicher Key, Zugriff über RLS abgesichert.
# Publishable-Key (sb_publishable_…) aus „Project Settings → API Keys“; alternativ SUPABASE_ANON_KEY
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: eigener MapLibre-Kartenstil (Standard: OpenFreeMap Positron, ohne API-Key)
NEXT_PUBLIC_MAP_STYLE_URL=

# Öffentliche URL der Seite (für Metadaten/OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: SalesViewer-Kennung (Standard: Konto der bisherigen Website). Leer setzen = SalesViewer aus.
# Geladen wird nur nach Zustimmung zu „Externe Dienste & Marketing“ im Cookie-Banner.
# NEXT_PUBLIC_SALESVIEWER_ID=
