# Datenquelle: "mock" (Standard ohne Supabase) oder "supabase"
DATA_SOURCE=mock

# Supabase (nur serverseitig genutzt – anon-Key, Zugriff über RLS abgesichert)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: eigener MapLibre-Kartenstil (Standard: OpenFreeMap Positron, ohne API-Key)
NEXT_PUBLIC_MAP_STYLE_URL=

# Öffentliche URL der Seite (für Metadaten/OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
