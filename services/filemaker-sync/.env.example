# FileMaker Server (Data API muss in der Admin Console aktiviert sein)
FILEMAKER_HOST=https://filemaker.example.com
FILEMAKER_DATABASE=Immobilien
FILEMAKER_USER=api_sync
FILEMAKER_PASSWORD=

# Supabase – service_role-Key umgeht RLS und darf NIE ins Frontend gelangen
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Wiederholung im Daemon-Modus (Minuten). Leer = einmaliger Lauf.
SYNC_INTERVAL_MINUTES=
